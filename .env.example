# Copy this file to .env and add your own values.
# Never commit .env or share API keys in screenshots/videos.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false
PORT=5000

# Optional: Gemini API integration. Without a key, the app uses a clearly labelled fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
